[Unit]
Description=Nexus Grounding Daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/grounding-daemon.sh
Restart=always
RestartSec=5
Environment="GROUNDING_CONFIG=/etc/nexus/grounding.yaml"
Environment="GROUNDING_LOG=/var/log/grounding.log"

[Install]
WantedBy=multi-user.target